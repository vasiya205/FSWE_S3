{
  "info": {
    "_postman_id": "8a7f35da-2d25-47a1-9e34-7cc0fc94d6ac",
    "name": "Home Tutor Finder API",
    "description": "Local API requests routed through the API Gateway. Login requests save the returned JWT in the active Postman environment. Keep credentials and generated tokens out of GitHub.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "activeUserId", "value": "", "type": "string" },
    { "key": "tutorUserId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "paymentSignature", "value": "", "type": "string" },
    { "key": "targetUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Student Example\",\n  \"email\": \"student@example.com\",\n  \"password\": \"change-this-password\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Register a student account. Use a unique email and a private password; do not use real account credentials in examples you share."
          }
        },
        {
          "name": "Student login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "if (data.token) {",
                "  pm.environment.set('token', data.token);",
                "  pm.collectionVariables.set('activeUserId', String(data.userId));",
                "  pm.test('Student login succeeded', function () { pm.response.to.have.status(200); });",
                "} else {",
                "  pm.test('Login response contains a token', function () { pm.expect(data.token).to.be.ok; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Tutor login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "if (data.token) {",
                "  pm.environment.set('token', data.token);",
                "  pm.collectionVariables.set('activeUserId', String(data.userId));",
                "  pm.collectionVariables.set('tutorUserId', String(data.userId));",
                "  pm.test('Tutor login succeeded', function () { pm.response.to.have.status(200); });",
                "} else {",
                "  pm.test('Login response contains a token', function () { pm.expect(data.token).to.be.ok; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tutorEmail}}\",\n  \"password\": \"{{tutorPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Admin login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "if (data.token) {",
                "  pm.environment.set('token', data.token);",
                "  pm.collectionVariables.set('activeUserId', String(data.userId));",
                "  pm.test('Admin login succeeded', function () { pm.response.to.have.status(200); });",
                "} else {",
                "  pm.test('Login response contains a token', function () { pm.expect(data.token).to.be.ok; });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Tutors",
      "item": [
        {
          "name": "Search tutors",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/tutors/search?subject=Mathematics"
          }
        },
        {
          "name": "Get tutor by user ID",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/tutors/user/{{tutorUserId}}"
          }
        },
        {
          "name": "Get my tutor profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tutors/me"
          }
        },
        {
          "name": "Create or update tutor profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{activeUserId}},\n  \"qualification\": \"BSc Mathematics\",\n  \"subject\": \"Mathematics\",\n  \"location\": \"Your city\",\n  \"experienceYears\": 2,\n  \"bio\": \"Describe your teaching experience.\",\n  \"hourlyRate\": 500\n}"
            },
            "url": "{{baseUrl}}/api/tutors/profile"
          }
        }
      ]
    },
    {
      "name": "Bookings and payments",
      "item": [
        {
          "name": "Create booking",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "if (data.id) pm.collectionVariables.set('bookingId', String(data.id));",
                "pm.test('Booking request returned successfully', function () { pm.response.to.have.status(200); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutorUserId\": {{tutorUserId}},\n  \"subject\": \"Mathematics\",\n  \"startDateTime\": \"2026-12-01T10:00:00\",\n  \"endDateTime\": \"2026-12-01T11:00:00\",\n  \"notes\": \"Please help me prepare for my exam.\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          },
          "description": "Use the user ID of a tutor with a saved profile. The server calculates the lesson price from the tutor's saved rate."
        },
        {
          "name": "My bookings (student)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings/my"
          }
        },
        {
          "name": "Incoming bookings (tutor)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings/incoming"
          }
        },
        {
          "name": "Update booking status (tutor)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status"
          },
          "description": "Log in as the tutor first. Supported booking statuses include ACCEPTED, REJECTED, and COMPLETED."
        },
        {
          "name": "Create Razorpay test order",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "if (data.orderId) pm.collectionVariables.set('orderId', data.orderId);",
                "pm.test('Order creation returned successfully', function () { pm.response.to.have.status(200); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/payments/order"
          },
          "description": "Requires the student token and an ACCEPTED, unpaid booking. This creates a sandbox order; it does not charge a real card."
        },
        {
          "name": "Verify Razorpay test payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentId\": \"{{paymentId}}\",\n  \"signature\": \"{{paymentSignature}}\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/payments/verify"
          },
          "description": "Use the real order ID, payment ID, and signature returned by a successful Razorpay test checkout. Do not invent a signature or paste keys into Postman. The website checkout is the easiest way to complete this flow."
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List all bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/bookings"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/admin/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/admin/users"
          }
        },
        {
          "name": "Enable or disable account",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin/users/{{targetUserId}}/enabled"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"tutorUserId\": {{tutorUserId}},\n  \"rating\": 5,\n  \"comment\": \"The lesson was clear and helpful.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews"
          },
          "description": "Use a completed booking. Review validation is enforced by the service."
        }
      ]
    }
  ]
}
